# Copie para backend/.env e preencha. O backend/.env NÃO vai para o git.
# Conexão principal com o ERP (lida por dashboard/db_conn.py)
UID=
PWD=
SERVER=
DATABASE=
# DRIVER=FreeTDS   (padrão; 'ODBC Driver 17 for SQL Server' no Windows)

# Django
DJANGO_SECRET_KEY=
# Gere com: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"

# Banco 'dados_industria' (settings.DATABASES)
MSSQL_INDUSTRIA_PASSWORD=

# Bot do Telegram (crie/renove no @BotFather)
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=Ctrigo_ruptura_alerta_bot

# Hosts extras aceitos pelo Django, separados por vírgula (opcional).
# Ex.: IP do PC na rede Wi-Fi para testar o app mobile no celular.
EXTRA_ALLOWED_HOSTS=

# Nível de log do app (INFO padrão; DEBUG para depurar)
DASHBOARD_LOG_LEVEL=INFO
